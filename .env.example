# Copy this file to .env for local development. Never commit the real .env file.
# Optional absolute SQLite path. Default: project/data/csdemo.sqlite3
# CS2_DATABASE=C:/path/to/csdemo.sqlite3
BACKEND_PORT=8091
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPDATE_STEAM_AVATARS_ON_START=true
STEAM_AVATAR_TIMEOUT_SECONDS=5
STEAM_AVATAR_WORKERS=4
